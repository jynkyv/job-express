
# Font configuration path (optional, for server deployment)
FONTCONFIG_PATH=/var/task/fonts

# Text AI API (server-only, OpenAI-compatible chat completions)
AI_API_KEY=
AI_API_BASE_URL=https://yunwu.ai/v1
AI_TEXT_MODEL=gemini-3.1-flash-lite

# Vision analysis API (optional overrides; falls back to AI_* when empty)
IMAGE_ANALYSIS_API_KEY=
IMAGE_ANALYSIS_API_BASE_URL=
IMAGE_ANALYSIS_MODEL=

# Yunwu image generation API (server-only, OpenAI-compatible images generations)
YUNWU_IMAGE_API_KEY=
YUNWU_IMAGE_API_BASE_URL=https://yunwu.ai/v1
YUNWU_IMAGE_MODEL=gpt-image-2
